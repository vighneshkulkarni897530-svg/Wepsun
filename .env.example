AWS_S3_BUCKET="wepsun-service-reports"
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"

# Email Delivery Infrastructure (Primary: Resend / Brevo HTTPS API | Fallback: Gmail SMTP)
# 1. Primary HTTPS Provider: Resend (HTTPS 443 — firewall-resilient)
RESEND_API_KEY=""
RESEND_FROM="WEPSUN Engineering <no-reply@wepsunengineering.com>" # Or "onboarding@resend.dev" for testing

# 2. Secondary HTTPS Provider: Brevo (HTTPS 443 — free 300 emails/day to any recipient)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="your-email@gmail.com"
BREVO_SENDER_NAME="WEPSUN Engineering"

# 2. Secondary Fallback: Gmail / Custom SMTP (Port 465 SSL or 587 STARTTLS)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-google-app-password"
SMTP_FROM="WEPSUN Engineering <your-email@gmail.com>"

# Communication & Messaging (WhatsApp & SMS Gateway)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
SMS_GATEWAY_API_KEY=""
SUPPORT_EMERGENCY_PHONE="+919820155432"

# Redis Cache & Background Jobs (BullMQ for PM Scheduling & AMC Alarms)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# AI Diagnostics Assistant (Gemini / OpenAI API)
AI_API_KEY="your-gemini-or-openai-api-key"
