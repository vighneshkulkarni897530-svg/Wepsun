# ==============================================================================
# WEPSUN Engineering Solutions – Production Environment Configuration
# Enterprise Multi-Tenant Lift Service & AMC Management Platform
# ==============================================================================

# Server Runtime & API Configuration
PORT=5000
NODE_ENV="production"
APP_ENV="production"
API_BASE_URL="https://api.wepsun.com"
VITE_API_URL="https://api.wepsun.com/api" # Use "/api" for same-domain or reverse proxy, or "http://localhost:5000/api" for local dev
NEXT_PUBLIC_APP_URL="https://admin.wepsun.com"
CUSTOMER_APP_URL="https://customer.wepsun.com"
CORS_ORIGINS="https://admin.wepsun.com,https://customer.wepsun.com,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://10.0.2.2:5000"

# Database (PostgreSQL 16 / Supabase / AWS RDS Connection Strings)
DATABASE_URL="postgresql://postgres:your_db_password@db.your-supabase-project.supabase.co:5432/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://postgres:your_db_password@db.your-supabase-project.supabase.co:5432/postgres?sslmode=require"

# JWT Authentication & Cryptographic Keys
JWT_SECRET="super-secure-random-32-byte-hex-secret-for-jwt-signing"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="another-secure-random-32-byte-secret-for-refresh-tokens"
REFRESH_TOKEN_EXPIRES_IN="30d"
AUTH_SECRET="super-secure-random-32-byte-hex-secret"

# Google OAuth 2.0 & Google Identity Services (GIS)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Firebase Cloud Messaging & Authentication (Push Notifications)
FIREBASE_PROJECT_ID="wepsun-engineering-app"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@wepsun-engineering-app.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Payment Gateway (Razorpay Online Checkout & Webhooks)
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# File & Document Storage (Cloudinary / AWS S3 for Photos & Signatures)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# AWS S3 Storage (Alternative / Archive)
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="wepsun-service-reports"
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"

# Communication & Messaging (WhatsApp, SMS Gateway & Resend Email)
RESEND_API_KEY="re_your_resend_api_key"
WHATSAPP_API_TOKEN="your_whatsapp_business_cloud_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
SMS_GATEWAY_API_KEY="your_fast2sms_or_msg91_key"
SUPPORT_EMERGENCY_PHONE="+919820155432"

# Redis Cache & Background Jobs (BullMQ for PM Scheduling & AMC Alarms)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# AI Diagnostics Assistant (Gemini / OpenAI API)
AI_API_KEY="your-gemini-or-openai-api-key"
